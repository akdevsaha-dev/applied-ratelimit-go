    {
      "id": "TSU_Miz4jJn_gUzcfKJbb",
      "type": "text",
      "x": 847.4276048575337,
      "y": -384.4586771932852,
      "width": 1216.578428204081,
      "height": 225,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1901461309,
      "version": 92,
      "versionNonce": 834114099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779989221949,
      "link": null,
      "locked": false,
      "text": "The Fixed Window Counter is the simplest and most straightforward\nrate-limiting algorithm. It divides time into fixed intervals (e.g.,\nseconds, minutes, or hours) and counts the number of requests\nwithin each interval. If the count exceeds a predefined threshold,\nthe requests are rejected until the next interval begins.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Fixed Window Counter is the simplest and most straightforward rate-limiting algorithm. It divides time into fixed intervals (e.g., seconds, minutes, or hours) and counts the number of requests within each interval. If the count exceeds a predefined threshold, the requests are rejected until the next interval begins.",
      "autoResize": false,
      "lineHeight": 1.25
    },
