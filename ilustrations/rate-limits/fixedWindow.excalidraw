      "updated": 1779995306000,
      "link": null,
      "locked": false,
      "text": "Careful go introduces race conditions because of its\nconcurrency.\n",
      "fontSize": 46.55114309343093,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Careful go introduces race conditions because of its concurrency.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WZCw3r-LyRMqW2GGKa9C2",
      "type": "text",
