    {
      "id": "nyqoIM2qUEvrkwFVcg6zd",
      "type": "text",
      "x": 1048.7824363225502,
      "y": 15.178327000385366,
      "width": 949.1397094726562,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 1609802941,
      "version": 659,
      "versionNonce": 580596957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779989235441,
      "link": null,
      "locked": false,
      "text": "// Get userId\n\nnot availabe?? get id of that user\n\ncreate the redis key cus redis stores key-value pair\nlike this\n\nrate_limit:user:12345\n\nincrement counter\n\nif error return;\n\nif count == 1 ? \nmeans user made the first request set the expiration.\n\nif count exceeds limit\nreturn exceeded limit message\n\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Get userId\n\nnot availabe?? get id of that user\n\ncreate the redis key cus redis stores key-value pair\nlike this\n\nrate_limit:user:12345\n\nincrement counter\n\nif error return;\n\nif count == 1 ? \nmeans user made the first request set the expiration.\n\nif count exceeds limit\nreturn exceeded limit message\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
