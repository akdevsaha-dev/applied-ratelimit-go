      "roundness": null,
      "seed": 771411365,
      "version": 58,
      "versionNonce": 1015542475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779995310743,
      "link": null,
      "locked": false,
      "text": "Use a Redis Pipeline to solve the race condition atomically",
      "fontSize": 42.38001628780622,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use a Redis Pipeline to solve the race condition atomically",
